# ==============================================================================
# PIPELINE CONFIGURATION FILE (LLM MODELS, PROMPTS & EXECUTION MODES)
# ==============================================================================

# LLM Provider & Model Settings
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=8192

# Mode 1: Raw IR directly into LLM -> Recovered C
PROMPT_MODE_RAW_IR="""You are an expert C decompiler.
Below is the raw LLVM IR lifted from an obfuscated binary:

{RAW_IR}

Please reconstruct the original, clean, executable C code (C11 standard) for this program.
Output ONLY the clean C code wrapped in ```c ... ``` codeblock.
"""

# Mode 2: Clean Pseudocode (LLVM-to-C Transpiled) directly into LLM -> Recovered C
PROMPT_MODE_CLEAN_PSEUDOCODE="""You are an expert C decompiler.
Below is the transpiled C pseudocode:

{CLEAN_PSEUDOCODE}

Please refactor and reconstruct clean, idiomatic C code (C11 standard) for this program.
Output ONLY the clean C code wrapped in ```c ... ``` codeblock.
"""

# Mode 3: Clean IR (Deobfuscated LLVM IR) directly into LLM -> Recovered C
PROMPT_MODE_CLEAN_IR="""You are an expert C decompiler.
Below is the deobfuscated, clean LLVM IR:

{CLEAN_IR}

Please reconstruct the original, clean, executable C code (C11 standard) for this program.
Output ONLY the clean C code wrapped in ```c ... ``` codeblock.
"""

# Mode 4: Both Clean IR and Clean Pseudocode into LLM -> Recovered C
PROMPT_MODE_CLEAN_IR_AND_PSEUDOCODE="""You are an expert C decompiler.
You are provided with both representations:

=== 1. DEOBFUSCATED CLEAN LLVM IR ===
{CLEAN_IR}

=== 2. TRANSPILER C PSEUDOCODE ===
{CLEAN_PSEUDOCODE}

Using both sources, reconstruct the original, clean, executable C code (C11 standard) for this program.
Output ONLY the clean C code wrapped in ```c ... ``` codeblock.
"""
